# Copiar a /srv/stacks/arriendaya/.env (permisos 600).
# nueva-bd-app.sh arriendaya ya escribe DB_NAME / DB_USER / DB_PASSWORD aqui solo:
# no hace falta copiarlos a mano, solo completar TAG, PUERTO y (opcional) el admin.

TAG=change-me-commit7
PUERTO=8103

# DB_NAME / DB_USER / DB_PASSWORD: los escribe nueva-bd-app.sh.

# Demo publico apagado por defecto (ver deploy/README.md, punto de seguridad). En "true"
# vuelve a crear propietario.demo / cliente.demo con clave fija: no usar en un servidor publico.
SEED_DEMO_USERS=false

# Sin estas dos no se crea ningun usuario administrador (AdminSeeder no tiene clave por
# defecto). Si se completan, usar una clave fuerte, no "admin1234".
ADMIN_EMAIL=
ADMIN_PASSWORD=
